# =============================================================================
# ClinTrial-Stream — Environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values. NEVER commit the .env file.
# Loaded automatically by Pydantic Settings at runtime.

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------
# The AWS region where all ClinTrial-Stream resources live
AWS_REGION=eu-west-2
# The AWS profile name (matches ~/.aws/credentials and ~/.aws/config)
AWS_PROFILE=clintrial

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment name — affects resource naming and logging verbosity
APP_ENV=dev
# Logging level — DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Kinesis stream
# -----------------------------------------------------------------------------
# Name of the Kinesis Data Stream that ingests trial events
KINESIS_STREAM_NAME=clintrial-events-dev
# Number of shards (1 shard = 1 MB/s ingest, 2 MB/s read)
KINESIS_SHARD_COUNT=2

# -----------------------------------------------------------------------------
# DynamoDB
# -----------------------------------------------------------------------------
# Single-table design — all entities live in one table
DYNAMODB_TABLE_NAME=clintrial-state-dev

# -----------------------------------------------------------------------------
# S3 (cold path / audit trail)
# -----------------------------------------------------------------------------
# Bucket where Kinesis Firehose archives every event for FDA audit compliance
S3_AUDIT_BUCKET=clintrial-audit-dev-677276115158

# -----------------------------------------------------------------------------
# Cognito (auth)
# -----------------------------------------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# -----------------------------------------------------------------------------
# Flask API
# -----------------------------------------------------------------------------
# Port the Flask app listens on locally
API_PORT=8000
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Producer (synthetic event generator)
# -----------------------------------------------------------------------------
# Events per second the simulator emits during demo runs
PRODUCER_RATE_EPS=50
# Total number of events to emit before stopping (0 = infinite)
PRODUCER_TOTAL_EVENTS=10000

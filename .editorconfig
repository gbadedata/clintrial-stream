# EditorConfig: https://editorconfig.org
# Top-most config file in this project
root = true

# Defaults for every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# Python: 4-space indent (PEP 8)
[*.py]
indent_size = 4
max_line_length = 100

# YAML, JSON, Terraform: 2-space indent (community convention)
[*.{yml,yaml,json,tf,tfvars,hcl}]
indent_size = 2

# Markdown: preserve trailing whitespace (used for line breaks)
[*.md]
trim_trailing_whitespace = false
max_line_length = 0

# Makefiles MUST use tabs (GNU make requirement)
[Makefile]
indent_style = tab

# Shell scripts: 2-space indent (Google style guide)
[*.sh]
indent_size = 2
